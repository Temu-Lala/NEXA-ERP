<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <!-- ==================== Operation Tasks ==================== -->
        <view id="view_ops_task_list" model="stock.operation.task" type="list">
            <field name="name" string="Reference"/>
            <field name="type" string="Task"/>
            <field name="product_id" string="Product"/>
            <field name="location_id" string="Zone"/>
            <field name="dest_location_id" string="To"/>
            <field name="quantity" string="Qty"/>
            <field name="picking_id" string="Transfer"/>
            <field name="wave_id" string="Wave"/>
            <field name="priority" string="Priority"/>
            <field name="assignee_id" string="Assignee"/>
            <field name="state" string="Status"/>
        </view>
        <view id="view_ops_task_form" model="stock.operation.task" type="form">
            <header>
                <button name="action_start" string="Start" type="object" class="sum_highlight" invisible="state not in ('draft', 'assigned')"/>
                <button name="action_verify_scan" string="Verify Scan" type="object" invisible="state != 'in_progress'"/>
                <button name="action_suggest_putaway" string="Suggest Location" type="object" invisible="type != 'putaway' or state in ('done', 'cancelled')"/>
                <button name="action_complete" string="Complete" type="object" class="sum_highlight" invisible="state != 'in_progress'"/>
                <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="type"/>
                    <field name="priority"/>
                    <field name="assignee_id"/>
                    <field name="wave_id"/>
                    <field name="picking_id"/>
                    <field name="move_id"/>
                </group>
                <group string="Work">
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="location_id"/>
                    <field name="dest_location_id"/>
                </group>
                <group string="Scan Evidence">
                    <field name="scan_code"/>
                    <field name="scan_match"/>
                </group>
                <group string="Notes">
                    <field name="override_reason" nolabel="1"/>
                    <field name="note" nolabel="1"/>
                </group>
            </sheet>
        </view>

        <!-- ==================== Waves ==================== -->
        <view id="view_ops_wave_list" model="stock.wave" type="list">
            <field name="name" string="Wave"/>
            <field name="warehouse_id" string="Warehouse"/>
            <field name="state" string="Status"/>
        </view>
        <view id="view_ops_wave_form" model="stock.wave" type="form">
            <header>
                <button name="action_finalize" string="Finalize" type="object" class="sum_highlight" invisible="state != 'draft'"/>
                <button name="action_generate" string="Generate Pick Tasks" type="object" invisible="state != 'finalized'"/>
                <button name="action_release" string="Release to Floor" type="object" class="sum_highlight" invisible="state != 'finalized'"/>
                <button name="action_done" string="Close Wave" type="object" invisible="state != 'released'"/>
                <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="warehouse_id"/>
                </group>
                <group string="Transfer Orders">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="picking_id"/>
                            <field name="origin"/>
                        </list>
                    </field>
                </group>
                <group>
                    <field name="note" nolabel="1"/>
                </group>
            </sheet>
        </view>

        <!-- ==================== Scan Log ==================== -->
        <view id="view_ops_scan_log_list" model="stock.ops.scan.log" type="list">
            <field name="scanned_at" string="When"/>
            <field name="name" string="Reference"/>
            <field name="task_id" string="Task"/>
            <field name="product_id" string="Product"/>
            <field name="scanned" string="Scanned"/>
            <field name="expected" string="Expected"/>
            <field name="matched" string="Match"/>
            <field name="scanned_by" string="By"/>
        </view>
        <view id="view_ops_scan_log_form" model="stock.ops.scan.log" type="form">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="task_id"/>
                    <field name="product_id"/>
                    <field name="scanned"/>
                    <field name="expected"/>
                    <field name="matched"/>
                    <field name="quantity"/>
                    <field name="scanned_by"/>
                    <field name="scanned_at"/>
                </group>
                <group>
                    <field name="note" nolabel="1"/>
                </group>
            </sheet>
        </view>

        <!-- ==================== Actions ==================== -->
        <action id="action_ops_task" type="window" model="stock.operation.task" name="Operation Tasks" view_mode="list,form"/>
        <action id="action_ops_wave" type="window" model="stock.wave" name="Waves" view_mode="list,form"/>
        <action id="action_ops_scan_log" type="window" model="stock.ops.scan.log" name="Scan Log" view_mode="list,form"/>
    </data>
</nexa>
