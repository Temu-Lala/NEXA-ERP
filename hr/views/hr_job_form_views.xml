<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <view id="view_hr_job_form" model="hr.job" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="Job Position..."/>
                    </h1>
                </div>
                <group col="2">
                    <group string="Position">
                        <field name="department_id"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <group string="Headcount">
                        <field name="no_of_employees"/>
                        <field name="expected_employees"/>
                    </group>
                </group>
                <notebook>
                    <page string="Employees" name="employees">
                        <field name="employee_ids">
                            <list>
                                <field name="name"/>
                                <field name="department_id"/>
                                <field name="work_email"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                    <page string="Description" name="description">
                        <field name="description" nolabel="1" placeholder="Role responsibilities, requirements..."/>
                    </page>
                </notebook>
            </sheet>
        </view>
    </data>
</nexa>
