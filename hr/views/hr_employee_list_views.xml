<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <view id="view_hr_employee_list" model="hr.employee" type="list" report_download="csv,pdf">
            <field name="name" string="Employee"/>
            <field name="employee_id" string="Employee ID"/>
            <field name="job_id" string="Job Position"/>
            <field name="department_id" string="Department"/>
            <field name="parent_id" string="Manager"/>
            <field name="work_email" string="Work Email" widget="email"/>
            <field name="work_phone" string="Work Phone" widget="phone"/>
            <field name="employment_type" string="Type"/>
            <field name="state" string="Status" widget="badge"/>
            <field name="active" string="Active" widget="boolean_toggle"/>
        </view>
    </data>
</nexa>
