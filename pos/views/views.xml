            </sheet>
        </view>
        <action id="action_pos_session" type="window" model="pos.session" name="Sessions" view_mode="kanban,list,form"/>
        <action id="action_pos_order" type="window" model="pos.order" name="Orders" view_mode="kanban,list,form"/>
        <action id="action_pos_order_line" type="window" model="pos.order.line" name="Order Lines" view_mode="list,form"/>
