        </view>

        <action id="action_pos_return" type="window" model="pos.return" name="Returns" view_mode="list,form"/>
        <action id="action_pos_return_line" type="window" model="pos.return" name="Return Lines" view_mode="list"/>
        <view id="view_pos_store_list" model="pos.store" type="list">
