<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <view id="view_pos_session_list" model="pos.session" type="list" default_order="id desc">
            <field name="name" string="Session"/>
            <field name="user_id" string="Cashier"/>
            <field name="config_name" string="Register"/>
            <field name="state" string="Status"/>
            <field name="start_at" string="Opened"/>
            <field name="stop_at" string="Closed"/>
            <field name="opening_cash" string="Open Cash" widget="monetary"/>
            <field name="expected_cash" string="Expected" widget="monetary"/>
            <field name="closing_cash" string="Counted" widget="monetary"/>
            <field name="cash_variance" string="Variance" widget="monetary"/>
        </view>
        <view id="view_pos_session_form" model="pos.session" type="form">
            <header><field name="state" widget="statusbar" options="{'clickable': '0'}"/></header>
            <sheet>
                <div class="sum_title"><h1><field name="name" placeholder="Session..."/></h1></div>
                <group>
                    <field name="user_id" string="Cashier"/>
                    <field name="config_name" string="Register/Config"/>
                    <field name="opening_cash" string="Opening Cash" widget="monetary"/>
                    <field name="expected_cash" string="Expected Cash" widget="monetary" readonly="true"/>
                    <field name="closing_cash" string="Counted Cash" widget="monetary"/>
                    <field name="cash_variance" string="Variance" widget="monetary" readonly="true"/>
                    <field name="start_at" string="Opened At"/>
                    <field name="stop_at" string="Closed At"/>
                </group>
                <notebook><page string="Orders"><field name="orders" nolabel="1"/></page></notebook>
            </sheet>
        </view>
        <view id="view_pos_order_list" model="pos.order" type="list" default_order="id desc">
            <field name="name" string="Receipt"/>
            <field name="session_id" string="Session"/>
            <field name="partner_id" string="Customer"/>
            <field name="state" string="Status"/>
            <field name="date_order" string="Date"/>
            <field name="amount_total" string="Total" widget="monetary"/>
            <field name="amount_paid" string="Paid" widget="monetary"/>
        </view>
        <view id="view_pos_order_form" model="pos.order" type="form">
            <header><field name="state" widget="statusbar" options="{'clickable': '0'}"/></header>
            <sheet>
                <div class="sum_title"><h1><field name="name" placeholder="Receipt..."/></h1></div>
                <group>
                    <field name="session_id" string="Session"/>
                    <field name="partner_id" string="Customer"/>
                    <field name="user_id" string="Cashier"/>
                    <field name="date_order" string="Date"/>
                    <field name="discount" string="Discount" widget="monetary"/>
                    <field name="amount_total" string="Total" widget="monetary" readonly="true"/>
                    <field name="amount_paid" string="Paid" widget="monetary" readonly="true"/>
                    <field name="points_earned" string="Points" readonly="true"/>
                </group>
                <notebook>
                    <page string="Lines"><field name="lines" nolabel="1"/></page>
                    <page string="Payments"><field name="payments" nolabel="1"/></page>
                    <page string="Note"><field name="note" string="Note"/></page>
                </notebook>
            </sheet>
        </view>
        <view id="view_pos_order_line_list" model="pos.order.line" type="list">
            <field name="order_id" string="Order"/>
            <field name="product_id" string="Product"/>
            <field name="name" string="Description"/>
            <field name="qty" string="Qty"/>
            <field name="price_unit" string="Price" widget="monetary"/>
            <field name="discount_pct" string="Disc %"/>
            <field name="price_subtotal" string="Subtotal" widget="monetary"/>
