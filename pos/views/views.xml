        <view id="view_pos_order_line_form" model="pos.order.line" type="form">
            <sheet>
                <group>
                    <field name="order_id" string="Order"/>
                    <field name="product_id" string="Product"/>
                    <field name="name" string="Description"/>
                    <field name="qty" string="Quantity"/>
                    <field name="price_unit" string="Unit Price" widget="monetary"/>
                    <field name="discount_pct" string="Discount %"/>
                    <field name="price_subtotal" string="Subtotal" widget="monetary"/>
                    <field name="sequence" string="Sequence"/>
                </group>
            </sheet>
        </view>
        <view id="view_pos_payment_list" model="pos.payment" type="list">
            <field name="order_id" string="Order"/>
            <field name="method" string="Method"/>
            <field name="amount" string="Amount" widget="monetary"/>
            <field name="reference" string="Reference"/>
            <field name="note" string="Note"/>
        </view>
        <view id="view_pos_payment_form" model="pos.payment" type="form">
            <sheet>
                <group>
                    <field name="order_id" string="Order"/>
                    <field name="method" string="Method"/>
                    <field name="amount" string="Amount" widget="monetary"/>
                    <field name="reference" string="Reference"/>
                    <field name="note" string="Note"/>
