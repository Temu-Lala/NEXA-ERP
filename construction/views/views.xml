<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <view id="view_construction_boq_list" model="construction.boq" type="list" default_order="id desc">
            <field name="name" string="BOQ"/>
            <field name="project_id" string="Project"/>
            <field name="revision" string="Rev"/>
            <field name="total_amount" string="Total"/>
            <field name="state" string="Status"/>
        </view>
        <view id="view_construction_boq_form" model="construction.boq" type="form">
            <header><field name="state" widget="statusbar" options="{'clickable': '0'}"/></header>
            <sheet>
                <div class="sum_title"><h1><field name="name" placeholder="BOQ reference..."/></h1></div>
                <group>
                    <field name="project_id" string="Project"/>
                    <field name="revision" string="Revision"/>
                    <field name="total_amount" string="Total" readonly="true"/>
                </group>
                <notebook>
                    <page string="Items"><field name="lines" nolabel="1"/></page>
                    <page string="Notes"><field name="description" string="Description"/></page>
                </notebook>
            </sheet>
        </view>
        <view id="view_construction_boq_line_list" model="construction.boq.line" type="list">
            <field name="boq_id" string="BOQ"/>
            <field name="code" string="Code"/>
            <field name="name" string="Description"/>
            <field name="section" string="Section"/>
            <field name="uom" string="Unit"/>
            <field name="quantity" string="Qty"/>
            <field name="unit_rate" string="Rate"/>
            <field name="amount" string="Amount"/>
            <field name="sequence" string="Seq"/>
        </view>
        <view id="view_construction_boq_line_form" model="construction.boq.line" type="form">
            <sheet>
                <group>
                    <field name="boq_id" string="BOQ"/>
                    <field name="code" string="Item Code"/>
                    <field name="name" string="Description"/>
                    <field name="section" string="Section"/>
                    <field name="uom" string="Unit"/>
                    <field name="quantity" string="Quantity"/>
                    <field name="unit_rate" string="Unit Rate"/>
                    <field name="amount" string="Amount" readonly="true"/>
                    <field name="sequence" string="Sequence"/>
                </group>
            </sheet>
        </view>
        <view id="view_construction_rfi_list" model="construction.rfi" type="list" default_order="id desc">
            <field name="name" string="RFI"/>
            <field name="project_id" string="Project"/>
            <field name="subject" string="Subject"/>
            <field name="priority" string="Priority"/>
            <field name="state" string="Status"/>
            <field name="date_raised" string="Raised"/>
            <field name="date_answered" string="Answered"/>
        </view>
        <view id="view_construction_rfi_form" model="construction.rfi" type="form">
            <header><field name="state" widget="statusbar" options="{'clickable': '0'}"/></header>
            <sheet>
                <div class="sum_title"><h1><field name="name" placeholder="RFI reference..."/></h1></div>
                <group>
                    <field name="project_id" string="Project"/>
                    <field name="subject" string="Subject"/>
                    <field name="priority" string="Priority"/>
                    <field name="raised_by_id" string="Raised By"/>
                    <field name="answered_by_id" string="Answered By"/>
                    <field name="date_raised" string="Raised Date"/>
                    <field name="date_answered" string="Answered Date"/>
                </group>
                <group string="Question"><field name="question" string="Question"/></group>
                <group string="Answer"><field name="answer" string="Answer"/></group>
            </sheet>
        </view>
        <view id="view_construction_variation_list" model="construction.variation" type="list" default_order="id desc">
            <field name="name" string="Variation"/>
            <field name="project_id" string="Project"/>
            <field name="subject" string="Subject"/>
            <field name="amount" string="Amount"/>
            <field name="state" string="Status"/>
            <field name="date_submitted" string="Submitted"/>
            <field name="date_decided" string="Decided"/>
        </view>
        <view id="view_construction_variation_form" model="construction.variation" type="form">
            <header><field name="state" widget="statusbar" options="{'clickable': '0'}"/></header>
            <sheet>
                <div class="sum_title"><h1><field name="name" placeholder="Variation reference..."/></h1></div>
                <group>
                    <field name="project_id" string="Project"/>
                    <field name="subject" string="Subject"/>
                    <field name="amount" string="Amount"/>
                    <field name="submitted_by" string="Submitted By"/>
                    <field name="approved_by" string="Approved By"/>
                    <field name="date_submitted" string="Submitted Date"/>
                    <field name="date_decided" string="Decision Date"/>
                </group>
                <group string="Description"><field name="description" string="Description"/></group>
            </sheet>
        </view>
        <view id="view_construction_diary_list" model="construction.diary" type="list" default_order="date desc, id desc">
            <field name="name" string="Entry"/>
            <field name="project_id" string="Project"/>
            <field name="date" string="Date"/>
            <field name="weather" string="Weather"/>
            <field name="manpower" string="Manpower"/>
            <field name="author_id" string="Author"/>
        </view>
        <view id="view_construction_diary_form" model="construction.diary" type="form">
            <sheet>
                <div class="sum_title"><h1><field name="name" placeholder="Diary entry..."/></h1></div>
                <group>
                    <field name="project_id" string="Project"/>
                    <field name="date" string="Date"/>
                    <field name="weather" string="Weather"/>
                    <field name="manpower" string="Manpower"/>
                    <field name="author_id" string="Author"/>
                </group>
                <group string="Work Done"><field name="work_done" string="Work Done"/></group>
                <group string="Issues / Delays"><field name="issues" string="Issues / Delays"/></group>
            </sheet>
        </view>
        <action id="action_construction_boq" type="window" model="construction.boq" name="Bills of Quantities" view_mode="list,form"/>
        <action id="action_construction_boq_line" type="window" model="construction.boq.line" name="BOQ Lines" view_mode="list,form"/>
        <action id="action_construction_rfi" type="window" model="construction.rfi" name="RFIs" view_mode="kanban,list,form"/>
        <action id="action_construction_variation" type="window" model="construction.variation" name="Variations" view_mode="kanban,list,form"/>
        <action id="action_construction_diary" type="window" model="construction.diary" name="Site Diaries" view_mode="list,form"/>
        <view id="view_construction_subcontract_list" model="construction.subcontract" type="list">
            <field name="name" string="Subcontract"/><field name="project_id" string="Project"/><field name="partner_id" string="Subcontractor"/><field name="contract_value" string="Value"/><field name="retention_pct" string="Ret %"/><field name="state" string="Status"/>
        </view>
        <view id="view_construction_subcontract_form" model="construction.subcontract" type="form">
            <header><field name="state" widget="statusbar" options="{'clickable': '0'}"/></header>
            <sheet>
                <div class="sum_title"><h1><field name="name" placeholder="Subcontract..."/></h1></div>
                <group><field name="project_id" string="Project"/><field name="partner_id" string="Subcontractor"/><field name="contract_value" string="Contract Value"/><field name="retention_pct" string="Retention %"/><field name="advance_amount" string="Advance"/><field name="advance_pct" string="Adv Recovery %"/><field name="start_date" string="Start"/><field name="end_date" string="End"/></group>
                <group string="Scope of Works"><field name="scope" string="Scope"/></group>
                <notebook><page string="Certificates"><field name="certificates" nolabel="1"/></page></notebook>
            </sheet>
        </view>
        <view id="view_construction_certificate_list" model="construction.certificate" type="list" default_order="id desc">
            <field name="name" string="Cert"/><field name="subcontract_id" string="Subcontract"/><field name="period" string="Period"/><field name="work_done_pct" string="Work %"/><field name="amount_this_period" string="Amount"/><field name="retention_held" string="Ret."/><field name="net_payable" string="Net"/><field name="cumulative_paid" string="Cum."/><field name="state" string="Status"/>
        </view>
        <view id="view_construction_certificate_form" model="construction.certificate" type="form">
            <header><field name="state" widget="statusbar" options="{'clickable': '0'}"/></header>
            <sheet>
                <div class="sum_title"><h1><field name="name" placeholder="Certificate..."/></h1></div>
                <group><field name="subcontract_id" string="Subcontract"/><field name="period" string="Period"/><field name="work_done_pct" string="Work Done %"/><field name="amount_this_period" string="Amount This Period"/><field name="retention_held" string="Retention Held"/><field name="advance_recovery" string="Advance Recovery"/><field name="net_payable" string="Net Payable" readonly="true"/><field name="cumulative_paid" string="Cumulative Paid" readonly="true"/><field name="certified_by_id" string="Certified By"/><field name="paid_at" string="Paid At"/></group>
                <group string="Note"><field name="note" string="Note"/></group>
            </sheet>
        </view>
        <action id="action_construction_subcontract" type="window" model="construction.subcontract" name="Subcontracts" view_mode="kanban,list,form"/>
        <action id="action_construction_certificate" type="window" model="construction.certificate" name="Payment Certificates" view_mode="kanban,list,form"/>

        <!-- ===== Workflow boards & search ===== -->
        <view id="view_construction_rfi_kanban" model="construction.rfi" type="kanban" default_group_by="state">
            <field name="state"/><field name="name"/><field name="project_id"/><field name="subject"/><field name="priority"/><field name="raised_by_id"/><field name="answered_by_id"/><field name="date_raised"/><field name="date_answered"/>
        </view>
        <view id="view_construction_rfi_search" model="construction.rfi" type="search">
            <field name="name"/><field name="subject"/><field name="question"/><field name="answer"/>
            <filter name="open" string="Open" domain='[["state","=","open"]]]'/>
            <filter name="answered" string="Answered" domain='[["state","=","answered"]]]'/>
            <filter name="closed" string="Closed" domain='[["state","=","closed"]]]'/>
            <filter name="urgent" string="Urgent" domain='[["priority","=","urgent"]]]'/>
            <filter name="high" string="High Priority" domain='[["priority","=","high"]]]'/>
            <filter name="group_state" string="Status" group_by="state"/>
            <filter name="group_project" string="Project" group_by="project_id"/>
            <filter name="group_priority" string="Priority" group_by="priority"/>
            <filter name="group_raised" string="Raised By" group_by="raised_by_id"/>
            <filter name="group_date" string="Raised Date" group_by="date_raised"/>
        </view>
        <view id="view_construction_variation_kanban" model="construction.variation" type="kanban" default_group_by="state">
            <field name="state"/><field name="name"/><field name="project_id"/><field name="subject"/><field name="amount" widget="monetary"/><field name="submitted_by"/><field name="approved_by"/><field name="date_submitted"/><field name="date_decided"/>
        </view>
        <view id="view_construction_variation_search" model="construction.variation" type="search">
            <field name="name"/><field name="subject"/><field name="description"/>
            <filter name="draft" string="Draft" domain='[["state","=","draft"]]]'/>
            <filter name="submitted" string="Submitted" domain='[["state","=","submitted"]]]'/>
            <filter name="approved" string="Approved" domain='[["state","=","approved"]]]'/>
            <filter name="rejected" string="Rejected" domain='[["state","=","rejected"]]]'/>
            <filter name="group_state" string="Status" group_by="state"/>
            <filter name="group_project" string="Project" group_by="project_id"/>
            <filter name="group_submitter" string="Submitted By" group_by="submitted_by"/>
        </view>
        <view id="view_construction_subcontract_kanban" model="construction.subcontract" type="kanban" default_group_by="state">
            <field name="state"/><field name="name"/><field name="project_id"/><field name="partner_id"/><field name="contract_value" widget="monetary"/><field name="retention_pct"/><field name="advance_amount" widget="monetary"/>
        </view>
        <view id="view_construction_subcontract_search" model="construction.subcontract" type="search">
            <field name="name"/><field name="scope"/>
            <filter name="draft" string="Draft" domain='[["state","=","draft"]]]'/>
            <filter name="active" string="Active" domain='[["state","=","active"]]]'/>
            <filter name="suspended" string="Suspended" domain='[["state","=","suspended"]]]'/>
            <filter name="completed" string="Completed" domain='[["state","=","completed"]]]'/>
            <filter name="group_state" string="Status" group_by="state"/>
            <filter name="group_project" string="Project" group_by="project_id"/>
            <filter name="group_partner" string="Subcontractor" group_by="partner_id"/>
        </view>
        <view id="view_construction_certificate_kanban" model="construction.certificate" type="kanban" default_group_by="state">
            <field name="state"/><field name="name"/><field name="subcontract_id"/><field name="period"/><field name="work_done_pct"/><field name="amount_this_period" widget="monetary"/><field name="net_payable" widget="monetary"/><field name="cumulative_paid" widget="monetary"/>
        </view>
        <view id="view_construction_certificate_search" model="construction.certificate" type="search">
            <field name="name"/><field name="period"/>
            <filter name="draft" string="Draft" domain='[["state","=","draft"]]]'/>
            <filter name="submitted" string="Submitted" domain='[["state","=","submitted"]]]'/>
            <filter name="certified" string="Certified" domain='[["state","=","certified"]]]'/>
            <filter name="paid" string="Paid" domain='[["state","=","paid"]]]'/>
            <filter name="rejected" string="Rejected" domain='[["state","=","rejected"]]]'/>
            <filter name="group_state" string="Status" group_by="state"/>
            <filter name="group_subcontract" string="Subcontract" group_by="subcontract_id"/>
            <filter name="group_period" string="Period" group_by="period"/>
        </view>
        <view id="view_construction_boq_search" model="construction.boq" type="search">
            <field name="name"/>
            <filter name="draft" string="Draft" domain='[["state","=","draft"]]]'/>
            <filter name="approved" string="Approved" domain='[["state","=","approved"]]]'/>
            <filter name="archived" string="Archived" domain='[["state","=","archived"]]]'/>
            <filter name="group_state" string="Status" group_by="state"/>
            <filter name="group_project" string="Project" group_by="project_id"/>
        </view>
        <view id="view_construction_diary_search" model="construction.diary" type="search">
            <field name="name"/><field name="work_done"/><field name="issues"/>
            <filter name="group_project" string="Project" group_by="project_id"/>
            <filter name="group_author" string="Author" group_by="author_id"/>
            <filter name="group_date" string="Date" group_by="date"/>
        </view>
    </data>
</nexa>
