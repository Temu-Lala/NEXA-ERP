<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <view id="view_project_resource_allocation_list" model="project.resource.allocation" type="list">
            <field name="project_id" string="Project"/>
            <field name="user_id" string="Employee"/>
            <field name="role" string="Role"/>
            <field name="alloc_pct" string="Allocation %"/>
            <field name="start_date" string="From"/>
            <field name="end_date" string="To"/>
            <field name="overalloc" string="Over-allocated" widget="boolean_toggle"/>
            <field name="state" string="Status"/>
        </view>
        <view id="view_project_resource_allocation_form" model="project.resource.allocation" type="form">
            <header>
                <button name="action_confirm" string="Confirm" type="object" class="sum_highlight" invisible="state != 'draft'"/>
                <button name="action_check" string="Check Capacity" type="object" invisible="state != 'confirmed'"/>
                <button name="action_release" string="Release" type="object" invisible="state != 'confirmed'"/>
                <field name="state" widget="statusbar" options="{'clickable': '0'}"/>
            </header>
            <sheet>
                <group>
                    <group string="Assignment">
                        <field name="project_id" string="Project"/>
                        <field name="user_id" string="Employee"/>
                        <field name="role" string="Role"/>
                    </group>
                    <group string="Capacity">
                        <field name="alloc_pct" string="Allocation %"/>
                        <field name="start_date" string="From"/>
                        <field name="end_date" string="To"/>
                        <field name="overalloc" string="Over-allocated"/>
                    </group>
                </group>
                <field name="note" string="Note"/>
            </sheet>
        </view>

        <view id="view_project_resource_request_list" model="project.resource.request" type="list">
            <field name="project_id" string="Project"/>
            <field name="user_id" string="Requested Employee"/>
            <field name="role" string="Role Needed"/>
            <field name="needed_pct" string="Needed %"/>
            <field name="requested_by" string="Requested By"/>
            <field name="state" string="Status"/>
        </view>
        <view id="view_project_resource_request_form" model="project.resource.request" type="form">
            <header>
                <button name="action_submit" string="Submit" type="object" class="sum_highlight" invisible="state != 'draft'"/>
                <button name="action_approve" string="Approve" type="object" class="sum_highlight" invisible="state != 'submitted'"/>
                <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'"/>
                <field name="state" widget="statusbar" options="{'clickable': '0'}"/>
            </header>
            <sheet>
                <group>
                    <group string="Request">
                        <field name="project_id" string="Project"/>
                        <field name="user_id" string="Requested Employee"/>
                        <field name="role" string="Role Needed"/>
                        <field name="needed_pct" string="Needed %"/>
                    </group>
                    <group string="Window &amp; Approval">
                        <field name="start_date" string="From"/>
                        <field name="end_date" string="To"/>
                        <field name="requested_by" string="Requested By"/>
                        <field name="approved_by" string="Approved By"/>
                    </group>
                </group>
                <field name="note" string="Justification"/>
            </sheet>
        </view>

        <action id="action_project_resource_allocation" type="window" model="project.resource.allocation" name="Allocations" view_mode="list,form"/>
        <action id="action_project_resource_allocation_over" type="window" model="project.resource.allocation" name="Over-allocated" view_mode="list,form" domain='[["overalloc","=","true"]]'/>
        <action id="action_project_resource_allocation_my" type="window" model="project.resource.allocation" name="My Allocations" view_mode="list,form" domain='[["user_id","=","$uid"]]'/>
        <action id="action_project_resource_request" type="window" model="project.resource.request" name="Resource Requests" view_mode="list,form"/>
    </data>
</nexa>
