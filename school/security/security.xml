<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <record id="module_category_school" model="sys.module.category">
            <field name="name">School</field>
            <field name="sequence">40</field>
        </record>
        <record id="group_school_clerk" model="core.group">
            <field name="name">School / Data Entry Clerk</field>
            <field name="category_id" ref="module_category_school"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_school_cashier" model="core.group">
            <field name="name">School / Cashier</field>
            <field name="category_id" ref="module_category_school"/>
            <field name="implied_ids" eval="[(4, ref('group_school_clerk'))]"/>
        </record>
        <record id="group_school_manager" model="core.group">
            <field name="name">School / Manager (Director)</field>
            <field name="category_id" ref="module_category_school"/>
            <field name="implied_ids" eval="[(4, ref('group_school_cashier'))]"/>
        </record>
    </data>
</nexa>
