<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <!-- ==================== Valuation Layers ==================== -->
        <view id="view_valuation_layer_list" model="stock.valuation.layer" type="list">
            <field name="name" string="Reference"/>
            <field name="product_id" string="Product"/>
            <field name="picking_id" string="Transfer"/>
            <field name="source" string="Type"/>
            <field name="method" string="Cost Method"/>
            <field name="quantity" string="Quantity"/>
            <field name="unit_value_cents" string="Unit (cents)"/>
            <field name="value_cents" string="Value (cents)"/>
            <field name="remaining_qty" string="Remaining Qty"/>
            <field name="remaining_value_cents" string="Remaining (cents)"/>
            <field name="date" string="Effective Date"/>
            <field name="reversed" string="Reversed"/>
        </view>
        <view id="view_valuation_layer_form" model="stock.valuation.layer" type="form">
            <header>
                <button name="action_reverse" string="Reverse (compensating)" type="object"
                        invisible="reversed == True or source == 'reversal'"/>
            </header>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="picking_id"/>
                    <field name="move_id"/>
                    <field name="source"/>
                    <field name="method"/>
                    <field name="date"/>
                </group>
                <group string="Posted Fact (immutable)">
                    <field name="quantity"/>
                    <field name="unit_value_cents"/>
                    <field name="value_cents"/>
                    <field name="currency_code"/>
                </group>
                <group string="Remaining Pool">
                    <field name="remaining_qty"/>
                    <field name="remaining_value_cents"/>
                    <field name="reversed"/>
                    <field name="reversal_of_id" invisible="reversal_of_id == 0"/>
                </group>
                <group>
                    <field name="description" nolabel="1"/>
                </group>
            </sheet>
        </view>

        <!-- ==================== Landed Costs ==================== -->
        <view id="view_landed_cost_list" model="stock.landed.cost" type="list">
            <field name="name" string="Reference"/>
            <field name="picking_id" string="Received Transfer"/>
            <field name="basis" string="Allocate By"/>
            <field name="state" string="Status"/>
        </view>
        <view id="view_landed_cost_form" model="stock.landed.cost" type="form">
            <header>
                <button name="action_confirm" string="Confirm" type="object" class="sum_highlight" invisible="state != 'draft'"/>
                <button name="action_post" string="Post Costs" type="object" class="sum_highlight" invisible="state != 'confirmed'"/>
                <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed')"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="picking_id"/>
                    <field name="basis"/>
                </group>
                <group string="Cost Lines">
                    <field name="lines" nolabel="1">
                        <list editable="bottom">
                            <field name="name" string="Description"/>
                            <field name="amount_cents" string="Amount (cents)"/>
                        </list>
                    </field>
                </group>
                <group>
                    <field name="note" nolabel="1"/>
                </group>
            </sheet>
        </view>

        <!-- ==================== Valuation Events (outbox) ==================== -->
        <view id="view_valuation_event_list" model="stock.valuation.event" type="list">
            <field name="name" string="Reference"/>
            <field name="event_type" string="Event"/>
            <field name="product_id" string="Product"/>
            <field name="layer_id" string="Layer"/>
            <field name="amount_cents" string="Amount (cents)"/>
            <field name="posted" string="Consumed"/>
            <field name="date" string="Published At"/>
        </view>
        <view id="view_valuation_event_form" model="stock.valuation.event" type="form">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="event_type"/>
                    <field name="product_id"/>
                    <field name="layer_id"/>
                    <field name="amount_cents"/>
                    <field name="posted"/>
                    <field name="date"/>
                </group>
                <group string="Details">
                    <field name="message" nolabel="1"/>
                </group>
            </sheet>
        </view>

        <!-- ==================== Actions ==================== -->
        <action id="action_valuation_layer" type="window" model="stock.valuation.layer" name="Valuation Layers" view_mode="list,form"/>
        <action id="action_landed_cost" type="window" model="stock.landed.cost" name="Landed Costs" view_mode="list,form"/>
        <action id="action_valuation_event" type="window" model="stock.valuation.event" name="Valuation Events" view_mode="list,form"/>
    </data>
</nexa>
