<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <!-- Guardian registry -->
        <view id="view_school_guardian_list" model="school.guardian" type="list">
            <field name="code" string="Code"/>
            <field name="name" string="Name"/>
            <field name="phone" string="Phone"/>
            <field name="email" string="Email"/>
            <field name="children_count" string="Learners"/>
            <field name="active" string="Active"/>
        </view>
        <view id="view_school_guardian_form" model="school.guardian" type="form">
            <sheet>
                <div class="sum_title"><h1><field name="name" placeholder="Guardian full name"/></h1></div>
                <group>
                    <group string="Guardian">
                        <field name="code"/>
                        <field name="partner_id"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="national_id"/>
                    </group>
                    <group string="Details">
                        <field name="address"/>
                        <field name="occupation"/>
                        <field name="employer"/>
                        <field name="children_count" readonly="true"/>
                    </group>
                </group>
                <notebook>
                    <page string="Learner Links">
                        <field name="learner_links" nolabel="1">
                            <list editable="bottom">
                                <field name="student_id"/>
                                <field name="relationship"/>
                                <field name="is_primary"/>
                                <field name="can_view_academic"/>
                                <field name="can_view_financial"/>
                                <field name="status"/>
                                <field name="valid_from"/>
                                <field name="valid_to"/>
                            </list>
                        </field>
                    </page>
                    <page string="Notes">
                        <field name="notes" nolabel="1"/>
                    </page>
                </notebook>
                <group>
                    <field name="company_id"/>
                    <field name="active"/>
                </group>
            </sheet>
        </view>
        <action id="action_school_guardian" type="window" model="school.guardian" name="Guardians" view_mode="list,form"/>

        <!-- Full relationship / access history across the school -->
        <view id="view_school_student_guardian_list" model="school.student.guardian" type="list">
            <field name="student_id" string="Student"/>
            <field name="guardian_id" string="Guardian"/>
            <field name="relationship" string="Relationship"/>
            <field name="is_primary" string="Primary"/>
            <field name="can_view_financial" string="Fin. View"/>
            <field name="can_view_academic" string="Academic View"/>
            <field name="status" string="Status"/>
            <field name="valid_from" string="Valid From"/>
            <field name="valid_to" string="Valid To"/>
        </view>
        <view id="view_school_student_guardian_form" model="school.student.guardian" type="form">
            <sheet>
                <group>
                    <group string="Relationship">
                        <field name="student_id"/>
                        <field name="guardian_id"/>
                        <field name="relationship"/>
                        <field name="is_primary"/>
                    </group>
                    <group string="Access Authorisation">
                        <field name="can_view_academic"/>
                        <field name="can_view_financial"/>
                        <field name="can_make_payments"/>
                        <field name="can_take_medical_action"/>
                    </group>
                </group>
                <group>
                    <group string="Validity / History">
                        <field name="status"/>
                        <field name="valid_from"/>
                        <field name="valid_to"/>
                        <field name="revoked_reason"/>
                    </group>
                    <group string="Record">
                        <field name="company_id"/>
                    </group>
                </group>
                <group>
                    <field name="notes"/>
                </group>
            </sheet>
        </view>
        <action id="action_school_student_guardian" type="window" model="school.student.guardian" name="Student-Guardian Links" view_mode="list,form"/>
    </data>
</nexa>
