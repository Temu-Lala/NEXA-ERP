<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data noupdate="true">
        <record id="cron_stock_replenishment_evaluate" model="sys.cron">
            <field name="name">Inventory: Evaluate replenishment rules</field>
            <field name="code">stock.replenishment.evaluate</field>
            <field name="interval_number">60</field>
            <field name="active">True</field>
        </record>
        <record id="cron_stock_reservation_release_stale" model="sys.cron">
            <field name="name">Inventory: Release stale reservations</field>
            <field name="code">stock.reservation.release.stale</field>
            <field name="interval_number">1440</field>
            <field name="active">True</field>
        </record>
        <record id="cron_stock_intransit_overdue" model="sys.cron">
            <field name="name">Inventory: Check in-transit arrivals overdue</field>
            <field name="code">stock.intransit.overdue.check</field>
            <field name="interval_number">1440</field>
            <field name="active">True</field>
        </record>
        <record id="cron_stock_report_metrics_compute" model="sys.cron">
            <field name="name">Inventory: Compute turnover and DIO metrics</field>
            <field name="code">stock.report.metrics.compute</field>
            <field name="interval_number">1440</field>
            <field name="active">True</field>
        </record>
        <record id="cron_stock_product_class_abc" model="sys.cron">
            <field name="name">Inventory: Classify products ABC/XYZ</field>
            <field name="code">stock.product.class.abc</field>
            <field name="interval_number">10080</field>
            <field name="active">True</field>
        </record>
    </data>
</nexa>
