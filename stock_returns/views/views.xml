<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <!-- ==================== Return Policies ==================== -->
        <view id="view_return_policy_list" model="stock.return.policy" type="list">
            <field name="name" string="Reference"/>
            <field name="product_id" string="Product"/>
            <field name="window_days" string="Window (days)"/>
            <field name="inspect_gate" string="Restock Needs Inspection"/>
            <field name="active" string="Active"/>
        </view>
        <view id="view_return_policy_form" model="stock.return.policy" type="form">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="window_days"/>
                    <field name="inspect_gate"/>
                    <field name="active"/>
                </group>
                <group>
                    <field name="note" nolabel="1"/>
                </group>
            </sheet>
        </view>

        <!-- ==================== Return Orders ==================== -->
        <view id="view_return_order_list" model="stock.return.order" type="list">
            <field name="name" string="Reference"/>
            <field name="type" string="Type"/>
            <field name="partner_id" string="Customer / Vendor"/>
            <field name="origin_picking_id" string="Delivered Transfer"/>
            <field name="warehouse_id" string="Warehouse"/>
            <field name="state" string="Status"/>
            <field name="date" string="Raised At"/>
        </view>
        <view id="view_return_order_form" model="stock.return.order" type="form">
            <header>
                <button name="action_confirm" string="Confirm &amp; Check Policy" type="object" class="sum_highlight" invisible="state != 'draft'"/>
                <button name="action_receive" string="Receive &amp; Dispose" type="object" class="sum_highlight" invisible="state != 'confirmed'"/>
                <button name="action_done" string="Close" type="object" invisible="state != 'received'"/>
                <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed')"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="type"/>
                    <field name="partner_id"/>
                    <field name="origin_picking_id"/>
                    <field name="warehouse_id"/>
                    <field name="policy_id"/>
                    <field name="date"/>
                </group>
                <group string="Return Lines">
                    <field name="lines" nolabel="1">
                        <list editable="bottom">
                            <field name="product_id" string="Product"/>
                            <field name="quantity" string="Qty"/>
                            <field name="lot_id" string="Lot"/>
                            <field name="serial_id" string="Serial"/>
                            <field name="condition" string="Condition"/>
                            <field name="disposition" string="Disposition"/>
                            <field name="eligible" string="Eligible"/>
                            <field name="inspected" string="Inspected"/>
                        </list>
                    </field>
                </group>
                <group>
                    <field name="note" nolabel="1"/>
                </group>
            </sheet>
        </view>

        <!-- ==================== Return Lines (flat) ==================== -->
        <view id="view_return_line_list" model="stock.return.line" type="list">
            <field name="order_id" string="Return Order"/>
            <field name="product_id" string="Product"/>
            <field name="quantity" string="Qty"/>
            <field name="condition" string="Condition"/>
            <field name="disposition" string="Disposition"/>
            <field name="eligible" string="Eligible"/>
            <field name="policy_note" string="Policy Check"/>
            <field name="inspected" string="Inspected"/>
        </view>
        <view id="view_return_line_form" model="stock.return.line" type="form">
            <header>
                <button name="action_inspect" string="Sign Off Inspection" type="object" class="sum_highlight" invisible="inspected == True"/>
            </header>
            <sheet>
                <group>
                    <field name="order_id"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="lot_id"/>
                    <field name="serial_id"/>
                    <field name="condition"/>
                    <field name="disposition"/>
                </group>
                <group string="Policy &amp; Inspection">
                    <field name="eligible"/>
                    <field name="policy_note"/>
                    <field name="inspected"/>
                    <field name="inspected_by"/>
                </group>
                <group>
                    <field name="note" nolabel="1"/>
                </group>
            </sheet>
        </view>

        <!-- ==================== Actions ==================== -->
        <action id="action_return_policy" type="window" model="stock.return.policy" name="Return Policies" view_mode="list,form"/>
        <action id="action_return_order" type="window" model="stock.return.order" name="Returns (RMA / DTV)" view_mode="list,form"/>
        <action id="action_return_line" type="window" model="stock.return.line" name="Return Lines" view_mode="list,form"/>
    </data>
</nexa>
