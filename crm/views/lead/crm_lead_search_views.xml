<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <view id="view_crm_lead_search" model="crm.lead" type="search">
            <field name="name"/>
            <field name="contact_name"/>
            <field name="email_from"/>
            <field name="phone"/>
            <field name="partner_id"/>
            <filter name="opportunity" string="Opportunities" domain='[["type","=","opportunity"]]'/>
            <filter name="lead" string="Leads" domain='[["type","=","lead"]]'/>
            <filter name="open" string="Open" domain='[["won_status","=","pending"]]'/>
            <filter name="won" string="Won" domain='[["won_status","=","won"]]'/>
            <filter name="lost" string="Lost" domain='[["won_status","=","lost"]]'/>
            <filter name="my" string="My pipeline" domain='[["user_id","=","$uid"]]'/>
            <filter name="unassigned" string="Unassigned" domain='[["user_id","=",false]]'/>
            <filter name="high_priority" string="High Priority" domain='[["priority","in",["2","3"]]]'/>
            <filter name="duplicates" string="Duplicates" domain='[["duplicate_lead_count",">",0]]'/>
            <filter name="recurring" string="Recurring" domain='[["recurring_revenue",">",0]]'/>
            <filter name="no_deadline" string="No Deadline" domain='[["date_deadline","=",false]]'/>
            <filter name="group_stage" string="Stage" group_by="stage_id"/>
            <filter name="group_user" string="Salesperson" group_by="user_id"/>
            <filter name="group_team" string="Sales Team" group_by="team_id"/>
            <filter name="group_deadline" string="Expected Closing" group_by="date_deadline"/>
        </view>
