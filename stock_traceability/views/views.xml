<?xml version="1.0" encoding="utf-8"?>
<nexa>
    <data>
        <!-- ==================== Traceability Event Chain ==================== -->
        <view id="view_trace_event_list" model="stock.traceability.event" type="list">
            <field name="date_done" string="Date"/>
            <field name="name" string="Reference"/>
            <field name="event_type" string="Event"/>
            <field name="product_id" string="Product"/>
            <field name="lot_id" string="Lot"/>
            <field name="serial_id" string="Serial"/>
            <field name="source_location_id" string="From"/>
            <field name="result_location_id" string="To"/>
            <field name="quantity" string="Qty"/>
            <field name="picking_id" string="Transfer"/>
        </view>
        <view id="view_trace_event_form" model="stock.traceability.event" type="form">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="event_type"/>
                    <field name="date_done"/>
                    <field name="product_id"/>
                    <field name="lot_id"/>
                    <field name="serial_id"/>
                </group>
                <group string="Movement">
                    <field name="source_location_id"/>
                    <field name="result_location_id"/>
                    <field name="quantity"/>
                    <field name="picking_id"/>
                </group>
                <group>
                    <field name="description" nolabel="1"/>
                </group>
            </sheet>
        </view>

        <!-- ==================== Lot Expiry Alerts ==================== -->
        <view id="view_expiry_alert_list" model="stock.lot.expiry.alert" type="list">
            <field name="lot_id" string="Lot"/>
            <field name="product_id" string="Product"/>
            <field name="expiration_on" string="Expiration"/>
            <field name="days_remaining" string="Days Left"/>
            <field name="severity" string="Severity"/>
            <field name="open" string="Open"/>
        </view>
        <view id="view_expiry_alert_form" model="stock.lot.expiry.alert" type="form">
            <header>
                <button name="action_alert_resolve" string="Resolve" type="object" class="sum_highlight" invisible="open == false"/>
                <field name="severity" widget="statusbar"/>
            </header>
            <sheet>
                <group>
                    <field name="lot_id"/>
                    <field name="product_id"/>
                    <field name="expiration_on"/>
                    <field name="days_remaining"/>
                    <field name="open"/>
                </group>
                <group>
                    <field name="message" nolabel="1"/>
                </group>
            </sheet>
        </view>

        <!-- ==================== Extend anchor lot form with dispositions ==================== -->
        <record id="view_stock_lot_form_trace_ext" model="sys.view">
            <field name="inherit_id" ref="stock.view_stock_lot_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_recall" string="Recall" type="object" class="sum_highlight" invisible="state == 'recalled'"/>
                    <button name="action_quarantine" string="Quarantine" type="object" invisible="state == 'quarantined'"/>
                    <button name="action_release" string="Release" type="object" class="sum_highlight" invisible="state == 'released'"/>
                </xpath>
            </field>
        </record>

        <!-- ==================== Actions ==================== -->
        <action id="action_trace_event" type="window" model="stock.traceability.event" name="Traceability Chain" view_mode="list,form"/>
        <action id="action_expiry_alert" type="window" model="stock.lot.expiry.alert" name="Expiry Alerts" view_mode="list,form"/>
    </data>
</nexa>
